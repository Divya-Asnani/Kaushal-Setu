# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase -> Settings -> Database -> Connection string -> URI).
# Used only for pgvector similarity search, which the REST client cannot express.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Legacy HS256 projects: Settings -> API -> JWT Secret. Leave blank to use JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=

# ---- Gemini (replaces OpenAI from the frozen spec) ----
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
# Fingerprint extraction runs entirely on Gemma (high free request-per-day
# allowance). Gemma has no structured-output mode, so JSON is parsed from a
# prompted schema and retried on the same model when a reply is malformed.
GEMINI_FINGERPRINT_MODEL=gemma-3-27b-it
FINGERPRINT_MAX_ATTEMPTS=3

# ---- Neo4j (Person 3; optional, matching degrades gracefully without it) ----
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Storage buckets ----
STORAGE_PROBLEM_BUCKET=problem-media
STORAGE_EXPERIENCE_BUCKET=experience-media
STORAGE_KNOWLEDGE_BUCKET=knowledge-case-media
STORAGE_CERTIFICATE_BUCKET=certificates
KNOWLEDGE_VIDEO_MAX_BYTES=52428800

# ---- Matching weights (prototype parameters, not trained coefficients) ----
MATCH_WEIGHT_PROBLEM=0.40
MATCH_WEIGHT_CONTEXT=0.30
MATCH_WEIGHT_VERIFIED=0.20
MATCH_WEIGHT_PROXIMITY=0.10
MATCH_CANDIDATE_POOL=50
SERVICE_REQUEST_TTL_HOURS=48
