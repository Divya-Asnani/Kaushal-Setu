# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only for pgvector similarity search, which the
# REST client cannot express. Supabase -> Settings -> Database -> Connection string.
# Prefer the SESSION POOLER string. The direct host below resolves to IPv6 only, which
# works from a machine with IPv6 but NOT from inside a Docker container on a default
# bridge network. The pooler is reachable over IPv4 and works in both.
#   Session pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct (IPv6):  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# Percent-encode special characters in the password: @ becomes %40, # becomes %23.
DATABASE_URL=
# Legacy HS256 projects: Settings -> API -> JWT Secret. Leave blank to use JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=

# ---- Gemini (replaces OpenAI from the frozen spec) ----
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
# Fingerprint extraction: Gemma first for its free daily allowance, with a Gemini
# backup because Gemma returns 500 INTERNAL intermittently and can run past a
# minute. Gemma has no structured-output mode, so its JSON is parsed from a
# prompted schema; the backup enforces a real JSON response.
# Set the fallback blank to run on Gemma alone.
GEMINI_FINGERPRINT_MODEL=gemma-4-31b-it
FINGERPRINT_MAX_ATTEMPTS=1
GEMINI_FINGERPRINT_FALLBACK_MODEL=gemini-3.5-flash-lite
FINGERPRINT_FALLBACK_ATTEMPTS=2
FINGERPRINT_TIMEOUT_SECONDS=20

# ---- Neo4j (Person 3; optional, matching degrades gracefully without it) ----
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Storage buckets ----
STORAGE_PROBLEM_BUCKET=problem-media
STORAGE_EXPERIENCE_BUCKET=experience-media
STORAGE_KNOWLEDGE_BUCKET=knowledge-case-media
STORAGE_CERTIFICATE_BUCKET=certificates
KNOWLEDGE_VIDEO_MAX_BYTES=52428800

# ---- Matching weights (prototype parameters, not trained coefficients) ----
MATCH_WEIGHT_PROBLEM=0.40
MATCH_WEIGHT_CONTEXT=0.30
MATCH_WEIGHT_VERIFIED=0.20
MATCH_WEIGHT_PROXIMITY=0.10
MATCH_CANDIDATE_POOL=50
SERVICE_REQUEST_TTL_HOURS=48
